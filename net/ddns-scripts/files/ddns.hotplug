#!/bin/sh

# Keep running updaters alive across transient link failures. They retry
# address detection on their configured retry interval until the link returns.
# Explicit service stop, package removal and shutdown still stop the workers.
case "$ACTION" in
	ifup)					# OpenWrt is giving a network not phys. Interface
		/etc/init.d/ddns enabled && /usr/lib/ddns/dynamic_dns_updater.sh -n "$INTERFACE" -- start
		;;
esac
